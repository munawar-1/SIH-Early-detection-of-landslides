# ==============================================================================
# Backend Server Environment Variables (.env)
# ==============================================================================

# Port the backend server listens on (Railway automatically injects $PORT)
PORT=8080

# Full JDBC connection URL for Supabase PostgreSQL database (with SSL mode)
# Example: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/landslide_db?sslmode=prefer

# Database username (e.g., postgres or postgres.<project-ref> for Supabase pooler)
SPRING_DATASOURCE_USERNAME=postgres

# Database password configured in your Supabase project settings
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password_here

# PostgreSQL JDBC Driver class
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Hibernate DDL generation mode ('update' to auto-migrate tables, 'validate' or 'none' in production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Internal/Public URL where the Python FastAPI ML microservice is deployed (e.g. Railway private network or public URL)
ML_SERVICE_URL=http://localhost:8000

# 256-bit secret key used to sign and verify JWT authentication tokens
JWT_SECRET=NERLandslideEarlyWarningSystemSecretKeySIH2026NorthEastIndiaSecurityToken987654321

# Comma-separated list of allowed frontend origins for CORS (e.g., Vercel domain and localhost)
ALLOWED_ORIGINS=https://ner-landslide-gis.vercel.app,http://localhost:5173,http://localhost:3000

# SMS gateway provider selection: 'TWILIO_MSG91_SIMULATED', 'TWILIO', or 'MSG91'
SMS_PROVIDER=TWILIO_MSG91_SIMULATED

# Twilio Account SID for emergency SMS alerts (optional if using simulation)
TWILIO_ACCOUNT_SID=

# Twilio Auth Token for emergency SMS alerts (optional if using simulation)
TWILIO_AUTH_TOKEN=

# Twilio registered sending phone number (e.g., +1234567890)
TWILIO_PHONE_NUMBER=

# MSG91 Auth Key for Indian SMS gateway (optional if using simulation)
MSG91_AUTH_KEY=

# MSG91 Sender ID approved with DLT registration (e.g., NERSIH)
MSG91_SENDER_ID=NERSIH

# Firebase Service Account JSON string content (for production Firebase Cloud Messaging push)
FIREBASE_CREDENTIALS_JSON=

# Alternatively, path to the service account JSON key file in the container
FIREBASE_SERVICE_ACCOUNT_PATH=
