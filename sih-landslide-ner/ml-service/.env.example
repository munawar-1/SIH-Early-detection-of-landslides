# ==============================================================================
# ML Microservice Environment Variables (.env)
# ==============================================================================

# Port the FastAPI service listens on (Railway automatically injects $PORT)
PORT=8000

# Absolute or relative path to the trained XGBoost/RandomForest model pickle artifact
MODEL_PATH=models/xgb_landslide_model.pkl

# Spring Boot backend base URL for push notifications / pipeline sync
BACKEND_URL=http://localhost:8080

# Comma-separated list of allowed origins for browser access / dashboard (or * for public)
ALLOWED_ORIGINS=https://ner-landslide-gis.vercel.app,http://localhost:5173,http://localhost:3000
