# ==============================================================================
# Mobile App (React Native / Expo) Environment Variables (.env)
# ==============================================================================

# Public URL of the Spring Boot Backend on Railway
# Example: https://landslide-backend-production.up.railway.app
EXPO_PUBLIC_API_BASE_URL=https://landslide-backend-production.up.railway.app

# Public URL of the FastAPI ML Service on Railway
# Example: https://landslide-ml-production.up.railway.app
EXPO_PUBLIC_ML_API_BASE_URL=https://landslide-ml-production.up.railway.app

# Firebase Web API Key for mobile client authentication (optional)
EXPO_PUBLIC_FIREBASE_API_KEY=

# Firebase Project ID for mobile client (optional)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ner-landslide-gis

# Expo Application Services (EAS) Project ID (generated via `eas init`)
EAS_PROJECT_ID=
